# Settings for the R6 server stack. `r6ctl setup` copies this to deploy\.env.
# deploy\.env is private (it is in .gitignore) -- never commit or share it.

# --- Tailscale Funnel (the free public address) -----------------------------
# A SINGLE-USE auth key from the second Tailscale account
# (Settings > Keys > Generate auth key; Reusable off, Ephemeral off, tag none).
# Only needed the first time; r6ctl removes it from this file once the node
# has logged in.
TS_AUTHKEY=
TS_HOSTNAME=r6-server

# Public address of the server, once known, e.g. https://r6-server.tailXXXX.ts.net
# (r6ctl fills this in for you.) Used for the invite links on the dashboard.
R6_SERVER_PUBLIC_URL=

# --- Cloudflare Tunnel (later, if you ever get a domain) --------------------
# Leave blank until then. See deploy\README.md, "Moving to a domain".
CLOUDFLARE_TUNNEL_TOKEN=

# --- AI model and resource caps ----------------------------------------------
R6_OLLAMA_MODEL=llama3.1:8b
# CPU threads the analysis may use (the PC has 20; WSL itself is capped at 10).
R6_THREADS=6
R6_SERVER_CPUS=6
R6_SERVER_MEM=8g
R6_OLLAMA_CPUS=6
R6_OLLAMA_MEM=10g

# Port on THIS PC's loopback only (for the USB app running on this machine).
R6_LOCAL_PORT=8000
