+			named = r.PlayerIndexByID(id)
+		}
 	}
-	if i > -1 {
+	if named > -1 {
+		a := DefuserPlantStart
+		if r.planted {
+			a = DefuserDisableStart
+		}
 		u := MatchUpdate{
-			Type:          a,
-			Username:      r.Header.Players[i].Username,
-			Time:          r.timeRaw,
-			TimeInSeconds: r.time,
+			Type:           a,
+			Username:       r.Header.Players[named].Username,
+			Time:           r.timeRaw,
+			TimeInSeconds:  r.time,
+			ElapsedSeconds: r.elapsed,
 		}
 		r.MatchFeedback = append(r.MatchFeedback, u)
 		log.Debug().Interface("match_update", u).Send()
-		r.lastDefuserPlayerIndex = i
+		r.lastDefuserPlayerIndex = named
 	}
-	// TODO: 0.00 can be present even if defuser was not disabled.
-	if !strings.HasPrefix(timer, "0.00") {
+
+	v, ok := countdownValue(timer)
+	if !ok {
 		return nil
 	}
-	a = DefuserDisableComplete
+	if r.defuserCountdownStart < 0 || v > r.defuserCountdownLast+countdownRestart {
+		if v < countdownMinStart {
+			return nil // not the start of a countdown
+		}
+		r.defuserCountdownStart, r.defuserCountdownDone = packet, false
+	}
+	r.defuserCountdownLast = v
+	if r.defuserCountdownDone || v >= countdownComplete {
+		return nil
+	}
+
+	// The countdown reached zero: this is the plant (or, once planted, the disable). Only the
+	// first packet that low counts, so one countdown gives one event.
+	r.defuserCountdownDone = true
+	a, role := DefuserDisableComplete, Defense
 	if !r.planted {
-		a = DefuserPlantComplete
+		a, role = DefuserPlantComplete, Attack
 		r.planted = true
 	}
+	who := r.lastDefuserPlayerIndex
+	if who < 0 {
+		who = r.interactingPlayer(r.defuserCountdownStart, packet, role)
+	}
+	r.lastDefuserPlayerIndex = -1
+	username := ""
+	if who > -1 {
+		username = r.Header.Players[who].Username
+	}
 	u := MatchUpdate{
-		Type:          a,
-		Username:      r.Header.Players[r.lastDefuserPlayerIndex].Username,
-		Time:          r.timeRaw,
-		TimeInSeconds: r.time,
+		Type:           a,
+		Username:       username,
+		Time:           r.timeRaw,
+		TimeInSeconds:  r.time,
+		ElapsedSeconds: r.elapsed,
 	}
 	r.MatchFeedback = append(r.MatchFeedback, u)
 	log.Debug().Interface("match_update", u).Send()
 	return nil
 }
+
+// dropImpossibleDisables removes "defuser disabled" events from a round the attackers won. A defuse
+// that completes ends the round in the defenders' favour, so a countdown that reached zero in a round
+// the attackers took (by the score) was a defuser killed in the last instant, not a defuse.
+func (r *Reader) dropImpossibleDisables() {
+	attackersWon := false
+	for _, t := range r.Header.Teams {
+		if t.Role == Attack && t.Won {
+			attackersWon = true
+		}
+	}
+	if !attackersWon {
+		return
+	}
+	kept := r.MatchFeedback[:0]
+	for _, u := range r.MatchFeedback {
+		if u.Type != DefuserDisableComplete {
+			kept = append(kept, u)
+		}
+	}
+	r.MatchFeedback = kept
+}
+
+// interactingPlayer returns the index of the player on the given side who was planting or disabling
+// in the countdown that ran from `start` to `end`, or -1 when the replay doesn't say clearly enough.
+// A player qualifies if their weapon-ready flag dropped as the countdown began and was still down
+// when it ended. If several qualify the one whose flag dropped first is taken; if none does, a
+// single player whose flag was already down and never changed (a shield held out, say) is.
+func (r *Reader) interactingPlayer(start, end int, role TeamRole) int {
+	type dropped struct{ at, index int }
+	var drops []dropped
+	var carried []int
+	for i, p := range r.Header.Players {
+		if p.controllerID == nil || p.TeamIndex < 0 || p.TeamIndex >= len(r.Header.Teams) ||
+			r.Header.Teams[p.TeamIndex].Role != role {
+			continue
+		}
+		id := string(p.controllerID)
+		seen, lastReady, firstDrop, allBefore := false, true, -1, true
+		for _, s := range r.readyStates {
+			if s.controller != id || s.offset > end {
+				continue
+			}
+			seen, lastReady = true, s.ready
+			inWindow := s.offset >= start-readyBefore && s.offset <= start+readyAfter
+			if !s.ready && inWindow && firstDrop < 0 {
+				firstDrop = s.offset
+			}
+			if s.offset >= start-readyBefore {
+				allBefore = false
+			}
+		}
+		if !seen || lastReady {
+			continue // nothing known, or ready again by the end: not the one interacting
+		}
+		if firstDrop >= 0 {
+			drops = append(drops, dropped{firstDrop, i})
+		} else if allBefore {
+			carried = append(carried, i)
+		}
+	}
+	switch {
+	case len(drops) > 0:
+		best := drops[0]
+		for _, d := range drops[1:] {
+			if d.at < best.at {
+				best = d
+			}
+		}
+		return best.index
+	case len(carried) == 1:
+		return carried[0]
+	}
+	return -1
+}
diff --git a/dissect/defuse_test.go b/dissect/defuse_test.go
new file mode 100644
index 0000000..2ff1393
--- /dev/null
+++ b/dissect/defuse_test.go
@@ -0,0 +1,251 @@
+package dissect
+
+import (
+	"testing"
+)
+
+// Synthetic streams laid out the way real Y11S3 replays are. (The layout was checked on 74 real
+// rounds, where this code and an independent Python reader agreed on every plant and defuse.)
+
+var (
+	ctrlA1 = []byte{0xB9, 0x38, 0x03, 0xF0} // attackers
+	ctrlA2 = []byte{0xBA, 0x38, 0x03, 0xF0}
+	ctrlA3 = []byte{0xBB, 0x38, 0x03, 0xF0}
+	ctrlD1 = []byte{0x4C, 0x38, 0x03, 0xF0} // defenders
+	ctrlD2 = []byte{0x4B, 0x38, 0x03, 0xF0}
+)
+
+// step is one thing in the stream: a defuser-timer packet, a weapon-ready change, or empty space.
+type step struct {
+	timer string
+	id    []byte // the player id an older-format timer packet carries (nil: four zero bytes)
+	ctrl  []byte
+	up    bool
+	pad   int
+}
+
+func tick(text string) step              { return step{timer: text} }
+func tickBy(text string, id []byte) step { return step{timer: text, id: id} }
+func flag(c []byte, up bool) step        { return step{ctrl: c, up: up} }
+func gap(n int) step                     { return step{pad: n} }
+func steps(s ...[]step) (out []step) { // flatten
+	for _, x := range s {
+		out = append(out, x...)
+	}
+	return
+}
+func one(s step) []step { return []step{s} }
+
+// countdown is a plant/defuse down to `low`: `who`'s flag drops in the first packet and rises just after
+// the end; later packets are spread out like the real thing (20-34 KB per countdown).
+func countdown(who []byte, low string, others ...step) []step {
+	out := []step{tick("6.982")}
+	if who != nil {
+		out = append(out, flag(who, false))
+	}
+	for _, v := range []string{"5.000", "3.000", "1.000"} {
+		out = append(out, gap(2000), tick(v))
+	}
+	out = append(out, gap(2000))
+	out = append(out, others...)
+	out = append(out, tick(low))
+	if who != nil {
+		out = append(out, gap(1500), flag(who, true))
+	}
+	return out
+}
+
+// play lays the steps out in one buffer and replays them through the listeners in stream order, as Read does.
+func play(t *testing.T, all []step) *Reader { return playWith(t, all, nil) }
+
+// playWith is play with a chance to adjust the reader (players, teams) before the stream is replayed.
+func playWith(t *testing.T, all []step, adjust func(*Reader)) *Reader {
+	t.Helper()
+	r := &Reader{lastDefuserPlayerIndex: -1, defuserCountdownStart: -1}
+	r.Header.Teams = [2]Team{{Role: Attack}, {Role: Defense}}
+	r.Header.Players = []Player{
+		{Username: "atk1", TeamIndex: 0, controllerID: ctrlA1},
+		{Username: "atk2", TeamIndex: 0, controllerID: ctrlA2},
+		{Username: "atk3", TeamIndex: 0, controllerID: ctrlA3},
+		{Username: "def1", TeamIndex: 1, controllerID: ctrlD1},
+		{Username: "def2", TeamIndex: 1, controllerID: ctrlD2},
+	}
+	if adjust != nil {
+		adjust(r)
+	}
+	type play struct {
+		offset int
+		s      step
+	}
+	var plays []play
+	b := make([]byte, 64)
+	for _, s := range all {
+		switch {
+		case s.timer != "":
+			b = append(b, 0x22, 0xA9, 0xC8, 0x58, 0xD9)
+			plays = append(plays, play{len(b), s})
+			b = append(b, byte(len(s.timer)))
+			b = append(b, s.timer...)
+			b = append(b, make([]byte, 34)...) // skipped bytes
+			if s.id != nil {
+				b = append(b, s.id...)
+			} else {
+				b = append(b, 0, 0, 0, 0)
+			}
+			b = append(b, make([]byte, 30)...)
+		case s.ctrl != nil:
+			b = append(b, 0x23)
+			b = append(b, s.ctrl...)
+			b = append(b, 0, 0, 0, 0)
+			b = append(b, readyStateIndicator...)
+			plays = append(plays, play{len(b), s})
+			b = append(b, 0, 0, 0, 0, 0, 0, 0, 0)
+			if s.up {
+				b[len(b)-8] = 1
+			}
+		default:
+			b = append(b, make([]byte, s.pad)...)
+		}
+	}
+	r.b = b
+	for _, p := range plays {
+		r.offset = p.offset
+		var err error
+		if p.s.timer != "" {
+			err = readDefuserTimer(r)
+		} else {
+			err = readReadyState(r)
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	return r
+}
+
+func kinds(r *Reader) (out []string) {
+	for _, u := range r.MatchFeedback {
+		out = append(out, u.Type.String()+":"+u.Username)
+	}
+	return
+}
+
+func same(t *testing.T, got []string, want ...string) {
+	t.Helper()
+	if len(got) != len(want) {
+		t.Fatalf("got %v, want %v", got, want)
+	}
+	for i := range got {
+		if got[i] != want[i] {
+			t.Fatalf("got %v, want %v", got, want)
+		}
+	}
+}
+
+func TestThePlayerWhoseFlagDropsAsTheCountdownStartsIsCreditedWithThePlant(t *testing.T) {
+	r := play(t, steps(one(gap(500)), countdown(ctrlA2, "0.003")))
+	same(t, kinds(r), "DefuserPlantComplete:atk2")
+}
+
+func TestTrailingZeroPacketsDoNotBecomeAFalseDisable(t *testing.T) {
+	// the old reader read the second 0.00x packet as a "disable" a moment after every plant
+	r := play(t, steps(countdown(ctrlA1, "0.008"), []step{tick("0.003"), tick("0.00"), tick("0.000")}))
+	same(t, kinds(r), "DefuserPlantComplete:atk1")
+}
+
+func TestAPlantThenADefuseByADefender(t *testing.T) {
+	r := play(t, steps(countdown(ctrlA3, "0.006"), one(gap(20000)), countdown(ctrlD2, "0.022")))
+	same(t, kinds(r), "DefuserPlantComplete:atk3", "DefuserDisableComplete:def2")
+}
+
+func TestACountdownThatNeverFinishesMakesNoEventAndTheNextOneIsAFreshPlant(t *testing.T) {
+	r := play(t, steps(countdown(ctrlA1, "3.660"), one(gap(9000)), countdown(ctrlA3, "0.003")))
+	same(t, kinds(r), "DefuserPlantComplete:atk3")
+}
+
+func TestOtherPlayersFlagsDroppingLaterInTheCountdownAreIgnored(t *testing.T) {
+	r := play(t, steps(countdown(ctrlA1, "0.003", flag(ctrlA3, false))))
+	same(t, kinds(r), "DefuserPlantComplete:atk1")
+}
+
+func TestADefenderIsNeverCreditedWithAPlant(t *testing.T) {
+	r := play(t, []step{tick("6.982"), flag(ctrlD1, false), flag(ctrlA3, false), tick("0.003")})
+	same(t, kinds(r), "DefuserPlantComplete:atk3")
+}
+
+func TestAFlagAlreadyDownThatNeverChangedIsTheLikelyPlanter(t *testing.T) {
+	r := play(t, steps(one(flag(ctrlA2, false)), one(gap(5000)), countdown(nil, "0.003")))
+	same(t, kinds(r), "DefuserPlantComplete:atk2")
+}
+
+func TestNobodyQualifyingLeavesTheNameBlankInsteadOfGuessing(t *testing.T) {
+	r := play(t, countdown(nil, "0.003"))
+	same(t, kinds(r), "DefuserPlantComplete:")
+}
+
+func TestAFlagThatIsBackUpByTheEndIsNotThePlanter(t *testing.T) {
+	r := play(t, []step{tick("6.982"), flag(ctrlA1, false), gap(100), flag(ctrlA1, true), tick("0.003")})
+	same(t, kinds(r), "DefuserPlantComplete:")
+}
+
+func TestALoneZeroPacketIsNotAnAttempt(t *testing.T) {
+	r := play(t, []step{tick("0.000"), gap(100), tick("0.00")})
+	same(t, kinds(r))
+}
+
+func TestTimerTextThatIsNotPlainDigitsIsIgnored(t *testing.T) {
+	r := play(t, []step{tick("nan"), tick("inf"), tick("1e3"), tick("7.9.1"), tick("-3")})
+	same(t, kinds(r))
+}
+
+func TestOlderReplaysThatNameThePlayerInThePacketAreStillCreditedByName(t *testing.T) {
+	// Older replays put the player's id 34 bytes after the timer text; that is exact, so it is used as
+	// before (a start event per named packet, then the completion credited to that player), even
+	// when the weapon-ready flag points at someone else.
+	id := []byte{9, 8, 7, 6}
+	r := playWith(t, []step{tickBy("6.982", id), flag(ctrlA1, false), tick("3.000"), tick("0.004")},
+		func(r *Reader) { r.Header.Players[1].DissectID = id })
+	same(t, kinds(r), "DefuserPlantStart:atk2", "DefuserPlantComplete:atk2")
+}
+
+func TestADefuseInARoundTheAttackersWonIsDropped(t *testing.T) {
+	r := &Reader{}
+	r.Header.Teams = [2]Team{{Role: Attack, Won: true}, {Role: Defense}}
+	r.MatchFeedback = []MatchUpdate{
+		{Type: DefuserPlantComplete, Username: "atk1"},
+		{Type: DefuserDisableComplete, Username: "def1"},
+	}
+	r.dropImpossibleDisables()
+	same(t, kinds(r), "DefuserPlantComplete:atk1")
+}
+
+func TestADefuseInARoundTheDefendersWonStays(t *testing.T) {
+	r := &Reader{}
+	r.Header.Teams = [2]Team{{Role: Attack}, {Role: Defense, Won: true}}
+	r.MatchFeedback = []MatchUpdate{
+		{Type: DefuserPlantComplete, Username: "atk1"},
+		{Type: DefuserDisableComplete, Username: "def1"},
+	}
+	r.dropImpossibleDisables()
+	same(t, kinds(r), "DefuserPlantComplete:atk1", "DefuserDisableComplete:def1")
+}
+
+func TestControllerIDIsReadFromJustBeforeThePlayerRecord(t *testing.T) {
+	r := &Reader{}
+	r.b = append(append(append(make([]byte, 40), controllerIndicator...), 0xB9, 0x38, 0x03, 0xF0), make([]byte, 30)...)
+	got := r.controllerIDBefore(len(r.b))
+	if string(got) != string(ctrlA1) {
+		t.Fatalf("got %x", got)
+	}
+	if r.controllerIDBefore(20) != nil {
+		t.Fatal("found an id where there is no marker")
+	}
+}
+
+func TestCountdownValueAcceptsOnlyPlainDigits(t *testing.T) {
+	for text, want := range map[string]bool{"6.982": true, "0.000": true, "7": true, "": false, "nan": false, "1e3": false, "-1": false, "1.2.3": false, "123456789": false} {
+		if _, ok := countdownValue(text); ok != want {
+			t.Errorf("%q: got %v, want %v", text, ok, want)
+		}
+	}
+}
