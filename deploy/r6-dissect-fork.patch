-		return err
+// Plants and defuses are a countdown (about 7 seconds down to 0) in the defuser-timer packets.
+//
+// Older replays put the interacting player's id 34 bytes after the timer text. Replays from
+// Y11S3 on do not, and the old code then credited whoever was first in the player list, and
+// reported a second "complete" a moment after every plant (two packets in a row read 0.00x), which
+// turned up as a defuse and flipped the round's win condition. The replay still records who is
+// doing it: that player's controller has a "weapon ready" flag that drops to false in the same
+// packet the countdown starts and comes back up just after it ends:
+//
+//	<controller entity> 00 00 00 00 <hash A4 DC 8D D4> 01 <ready>
+//
+// A player's controller entity is written just before their player record (controllerIndicator).
+var (
+	readyStateIndicator = []byte{0xA4, 0xDC, 0x8D, 0xD4, 0x01}
+	controllerIndicator = []byte{0x84, 0x1D, 0x24, 0xAB, 0x01, 0x00, 0x00, 0x00, 0x01, 0x00, 0x1B}
+)
+
+const (
+	countdownRestart  = 0.5  // a value rising by this much means a new attempt (the last was let go)
+	countdownMinStart = 1.0  // a real countdown starts near 7, so a lone "0.00" is not an attempt
+	countdownComplete = 0.05 // a countdown that gets this low has completed
+	readyBefore       = 256  // the flag drops within this window around the countdown's first packet
+	readyAfter        = 1024
+)
+
+type readyState struct {
+	offset     int
+	controller string
+	ready      bool
+}
+
+// controllerIDBefore finds the controller entity id written in the 120 bytes before `end`.
+func (r *Reader) controllerIDBefore(end int) []byte {
+	if end > len(r.b) {
+		return nil
 	}
-	if err = r.Skip(34); err != nil {
-		return err
+	start := end - 120
+	if start < 0 {
+		start = 0
 	}
-	id, err := r.Bytes(4)
+	i := bytes.LastIndex(r.b[start:end], controllerIndicator)
+	if i < 0 {
+		return nil
+	}
+	i += start + len(controllerIndicator)
+	if i+4 > len(r.b) {
+		return nil
+	}
+	return bytes.Clone(r.b[i : i+4])
+}
+
+// readReadyState records one change of a controller's "weapon ready" flag.
+func readReadyState(r *Reader) error {
+	start := r.offset - len(readyStateIndicator) - 8 // controller id, then four zero bytes, then the hash
+	if start < 1 || r.offset >= len(r.b) || r.b[start-1] != 0x23 ||
+		!bytes.Equal(r.b[start+4:start+8], []byte{0x00, 0x00, 0x00, 0x00}) {
+		return nil
+	}
+	r.readyStates = append(r.readyStates, readyState{
+		offset:     r.offset,
+		controller: string(r.b[start : start+4]),
+		ready:      r.b[r.offset] != 0,
+	})
+	return nil
+}
+
+// countdownValue reads the timer text ("6.982"); plain digits only.
+func countdownValue(text string) (float64, bool) {
+	if text == "" || len(text) > 8 {
+		return 0, false
+	}
+	dots := 0
+	for _, c := range text {
+		switch {
+		case c == '.':
+			dots++
+		case c < '0' || c > '9':
+			return 0, false
+		}
+	}
+	if dots > 1 {
+		return 0, false
+	}
+	v, err := strconv.ParseFloat(text, 64)
+	return v, err == nil
+}
+
+func readDefuserTimer(r *Reader) error {
+	packet := r.offset
+	timer, err := r.String()
 	if err != nil {
 		return err
